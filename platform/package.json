{
  "name": "dart-flutter-lab-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "lab:bundle": "node scripts/build-lab-bundle.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "check": "astro check && npm run check:content && eslint . && npm run format:check",
    "build": "npm run lab:bundle && npm run check:content && astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:lighthouse": "lhci autorun",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "6.4.8",
    "dexie": "4.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/archiver": "8.0.0",
    "archiver": "8.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}
