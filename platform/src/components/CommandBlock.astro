---
interface Props {
  command: string;
  label?: string;
}

const { command, label = 'Comando local' } = Astro.props;
---

<figure class="command-block">
  <figcaption>{label}</figcaption>
  <div class="command-block__line">
    <code>{command}</code>
    <button type="button" data-copy-command={command} aria-label={`Copiar: ${command}`}
      >Copiar</button
    >
  </div>
  <span class="copy-feedback" aria-live="polite"></span>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-command]').forEach((button) => {
    button.addEventListener('click', async () => {
      const feedback = button
        .closest('.command-block')
        ?.querySelector<HTMLElement>('.copy-feedback');
      try {
        await navigator.clipboard.writeText(button.dataset.copyCommand ?? '');
        button.textContent = 'Copiado';
        button.dataset.state = 'success';
        if (feedback) feedback.textContent = 'Comando copiado.';
        window.setTimeout(() => {
          button.textContent = 'Copiar';
          delete button.dataset.state;
          if (feedback) feedback.textContent = '';
        }, 2500);
      } catch {
        button.dataset.state = 'error';
        if (feedback)
          feedback.textContent = 'No se pudo copiar. Selecciona el comando manualmente.';
      }
    });
  });
</script>

<style>
  .command-block {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
    margin: 0;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .command-block__line {
    display: flex;
    align-items: stretch;
    min-width: 0;
    border: var(--rule-strong) solid var(--color-ink);
    background: var(--color-code);
    color: var(--color-code-ink);
  }

  .command-block__line code {
    flex: 1;
    min-width: 0;
    padding: var(--space-sm) var(--space-md);
    border: 0;
    background: var(--color-code);
    color: var(--color-code-ink);
    overflow-x: auto;
    white-space: nowrap;
  }

  button {
    flex: 0 0 auto;
    min-height: 3rem;
    padding-inline: var(--space-md);
    border: 0;
    border-inline-start: var(--rule-strong) solid var(--color-code-ink);
    background: var(--color-acid);
    color: var(--color-acid-ink);
    font-weight: 700;
  }

  button[data-state='error'] {
    background: var(--color-danger);
    color: var(--color-paper-raised);
  }

  .copy-feedback {
    min-height: 1lh;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
