---
import { SITE } from '../config';
import { getCatalog } from '../lib/catalog';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const catalog = await getCatalog();
const links = [
  { href: '/hoy/', label: 'Hoy', short: 'Hoy' },
  { href: '/ruta/', label: 'Ruta', short: 'Ruta' },
  { href: '/documentacion/', label: 'Documentación', short: 'Docs' },
  { href: '/repasos/', label: 'Repasos', short: 'Repasos' },
  { href: '/progreso/', label: 'Progreso', short: 'Progreso' },
];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="mobile-head">
  <a class="mobile-head__brand" href="/" aria-label={`Inicio de ${SITE.name}`}>
    <span aria-hidden="true">D/F</span>
    <strong>LAB</strong>
  </a>
  <button class="search-trigger" type="button" data-search-open aria-haspopup="dialog">
    Buscar <kbd>/</kbd>
  </button>
</header>

<aside class="site-rail" aria-label="Navegación principal">
  <a class="wordmark" href="/" aria-label={`Inicio de ${SITE.name}`}>
    <span>DART</span>
    <span class="wordmark__amp">&</span>
    <span>FLUTTER</span>
    <strong>LAB</strong>
  </a>

  <nav class="rail-nav">
    {
      links.map((link) => (
        <a
          class:list={['rail-nav__link', { 'is-active': isActive(link.href) }]}
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          <span>{link.label}</span>
          <span class="rail-nav__mark" aria-hidden="true">
            {isActive(link.href) ? '■' : '□'}
          </span>
        </a>
      ))
    }
  </nav>

  <div class="rail-tools">
    <button
      class="search-trigger search-trigger--wide"
      type="button"
      data-search-open
      aria-haspopup="dialog"
    >
      Buscar en el curso <kbd>/</kbd>
    </button>
    <a href="/notas/">Notas</a>
    <a href="/metodo/">Método PENSAR</a>
    <a href="/ajustes/datos/">Tus datos</a>
  </div>
</aside>

<nav class="bottom-nav" aria-label="Navegación móvil">
  {
    links.map((link) => (
      <a
        class:list={['bottom-nav__link', { 'is-active': isActive(link.href) }]}
        href={link.href}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        {link.short}
      </a>
    ))
  }
</nav>

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-dialog__head">
    <div>
      <p class="eyebrow">Índice local</p>
      <h2 id="search-title">Busca una duda concreta</h2>
    </div>
    <button
      class="search-dialog__close"
      type="button"
      data-search-close
      aria-label="Cerrar búsqueda">Cerrar</button
    >
  </div>
  <label class="search-label" for="course-search">Concepto, error o API</label>
  <input
    id="course-search"
    class="search-input"
    type="search"
    autocomplete="off"
    placeholder="Ejemplo: late final"
    data-search-input
  />
  <div class="search-filters" aria-label="Filtros de búsqueda">
    <label>
      Ruta
      <select data-search-track>
        <option value="">Todas</option>
        <option value="dart">Dart</option>
        <option value="flutter">Flutter</option>
      </select>
    </label>
    <label>
      Módulo
      <select data-search-module>
        <option value="">Todos</option>
        {
          catalog.modules.map((module) => (
            <option value={module.data.id}>
              {module.data.id} · {module.data.title}
            </option>
          ))
        }
      </select>
    </label>
  </div>
  <p class="search-status" data-search-status aria-live="polite">
    Escribe al menos dos caracteres.
  </p>
  <ol class="search-results" data-search-results></ol>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-search-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-search-close]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const results = document.querySelector<HTMLOListElement>('[data-search-results]');
  const trackFilter = document.querySelector<HTMLSelectElement>('[data-search-track]');
  const moduleFilter = document.querySelector<HTMLSelectElement>('[data-search-module]');

  const open = () => {
    dialog?.showModal();
    input?.focus();
  };
  openButtons.forEach((button) => button.addEventListener('click', open));
  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.addEventListener('keydown', (event) => {
    if (
      event.key === '/' &&
      !event.metaKey &&
      !event.ctrlKey &&
      document.activeElement?.tagName !== 'INPUT' &&
      document.activeElement?.tagName !== 'TEXTAREA'
    ) {
      event.preventDefault();
      open();
    }
  });

  let searchTimer = 0;
  const runSearch = () => {
    window.clearTimeout(searchTimer);
    const term = input?.value.trim() ?? '';
    if (term.length < 2) {
      if (results) results.replaceChildren();
      if (status) status.textContent = 'Escribe al menos dos caracteres.';
      return;
    }
    if (status) status.textContent = 'Buscando…';
    searchTimer = window.setTimeout(async () => {
      try {
        const pagefindPath = '/pagefind/pagefind.js';
        const pagefind = await import(/* @vite-ignore */ pagefindPath);
        const filters: Record<string, string> = {};
        if (trackFilter?.value) filters.track = trackFilter.value;
        if (moduleFilter?.value) filters.module = moduleFilter.value;
        const found = await pagefind.search(term, { filters });
        if (!found || !results || !status) return;
        const items = await Promise.all(
          found.results.slice(0, 8).map(
            (result: {
              data: () => Promise<{
                url: string;
                meta: { title?: string };
                plain_excerpt: string;
              }>;
            }) => result.data(),
          ),
        );
        results.replaceChildren(
          ...items.map((item) => {
            const li = document.createElement('li');
            const link = document.createElement('a');
            const title = document.createElement('strong');
            const excerpt = document.createElement('span');
            link.href = item.url;
            title.textContent = item.meta.title ?? 'Resultado';
            excerpt.textContent = item.plain_excerpt;
            link.append(title, excerpt);
            li.append(link);
            return li;
          }),
        );
        status.textContent = `${items.length} resultados visibles.`;
      } catch {
        if (status)
          status.textContent = 'La búsqueda se activa en la versión construida del sitio.';
      }
    }, 250);
  };
  input?.addEventListener('input', runSearch);
  trackFilter?.addEventListener('change', runSearch);
  moduleFilter?.addEventListener('change', runSearch);
</script>

<style>
  .mobile-head {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    padding: var(--space-xs) var(--page-gutter);
    border-block-end: var(--rule-strong) solid var(--color-ink);
    background: var(--color-paper);
  }

  .mobile-head__brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-family: var(--font-display);
    text-decoration: none;
  }

  .mobile-head__brand span {
    padding: 0 var(--space-2xs);
    background: var(--color-acid);
  }

  .site-rail {
    display: none;
  }

  .bottom-nav {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--z-sticky);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding-block-end: env(safe-area-inset-bottom);
    border-block-start: var(--rule-strong) solid var(--color-ink);
    background: var(--color-paper-raised);
  }

  .bottom-nav__link {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 3.5rem;
    padding-inline: var(--space-2xs);
    font-size: clamp(0.66rem, 2.7vw, var(--text-xs));
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .bottom-nav__link.is-active {
    background: var(--color-acid);
    color: var(--color-acid-ink);
  }

  .search-trigger,
  .search-dialog__close {
    min-height: 2.75rem;
    padding-inline: var(--space-sm);
    border: var(--rule-strong) solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-hard);
    font-weight: 700;
    transition:
      transform var(--dur-press) var(--ease-out),
      box-shadow var(--dur-press) var(--ease-out);
  }

  .search-trigger:active,
  .search-dialog__close:active {
    transform: translate(0.125rem, 0.125rem);
    box-shadow: var(--shadow-pressed);
  }

  kbd {
    padding-inline: var(--space-2xs);
    border: var(--rule-thin) solid var(--color-rule);
    background: var(--color-paper-deep);
  }

  .search-dialog {
    position: fixed;
    inset: 0;
    width: min(calc(100% - 2rem), 44rem);
    height: fit-content;
    max-height: min(80dvh, 44rem);
    margin: auto;
    overflow: auto;
    padding: var(--space-lg);
    border: var(--rule-strong) solid var(--color-ink);
    border-radius: var(--radius-sm);
    background: var(--color-paper-raised);
    color: var(--color-ink);
    box-shadow: 0.5rem 0.5rem 0 var(--color-shadow);
  }

  .search-dialog::backdrop {
    background: color-mix(in oklch, var(--color-ink) 65%, transparent);
  }

  .search-dialog__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-lg);
  }

  .search-dialog h2 {
    font-size: var(--text-xl);
  }

  .search-label {
    display: block;
    margin-block-end: var(--space-xs);
    font-weight: 700;
  }

  .search-input {
    width: 100%;
    min-height: 3rem;
    padding-inline: var(--space-md);
    border: var(--rule-strong) solid var(--color-ink);
    outline: var(--rule-focus) solid transparent;
    outline-offset: 0.1rem;
    background: var(--color-paper);
  }

  .search-input:focus-visible {
    outline-color: var(--color-focus);
  }

  .search-status {
    min-height: 1lh;
    margin-block: var(--space-sm);
    color: var(--color-ink-muted);
  }

  .search-filters {
    display: grid;
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
  }

  .search-filters label {
    display: grid;
    gap: var(--space-2xs);
    min-width: 0;
    font-weight: 700;
  }

  .search-filters select {
    width: 100%;
    min-height: 3rem;
    padding-inline: var(--space-sm);
    border: var(--rule-strong) solid var(--color-ink);
    border-radius: var(--radius-none);
    background: var(--color-paper);
  }

  .search-results {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .search-results a {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-sm);
    border-block-start: var(--rule-thin) solid var(--color-rule);
    text-decoration: none;
  }

  .search-results span {
    color: var(--color-ink-muted);
  }

  @media (min-width: 60rem) {
    .mobile-head,
    .bottom-nav {
      display: none;
    }

    .site-rail {
      position: sticky;
      inset-block-start: 0;
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
      max-height: 100dvh;
      padding: var(--space-xl) var(--space-lg);
      overflow-y: auto;
      border-inline-start: var(--rule-thin) solid var(--color-rule-soft);
      background: var(--color-paper);
    }

    .wordmark {
      display: grid;
      width: fit-content;
      font-family: var(--font-display);
      font-size: var(--text-lg);
      line-height: 0.92;
      text-decoration: none;
    }

    .wordmark__amp {
      color: var(--color-ink-muted);
      font-family: var(--font-body);
      font-size: var(--text-sm);
      line-height: 1.2;
    }

    .wordmark strong {
      width: fit-content;
      margin-block-start: var(--space-xs);
      padding: var(--space-2xs) var(--space-xs);
      background: var(--color-acid);
      font-size: var(--text-sm);
      letter-spacing: 0.08em;
    }

    .rail-nav {
      display: grid;
      margin-block-start: var(--space-2xl);
      border-block-start: var(--rule-strong) solid var(--color-ink);
    }

    .rail-nav__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 3.25rem;
      padding-inline: var(--space-xs);
      border-block-end: var(--rule-thin) solid var(--color-rule);
      font-weight: 700;
      text-decoration: none;
    }

    .rail-nav__link.is-active {
      background: var(--color-acid);
      color: var(--color-acid-ink);
    }

    .rail-nav__mark {
      font-family: var(--font-mono);
    }

    .rail-tools {
      display: grid;
      gap: var(--space-sm);
      margin-block-start: auto;
      padding-block-start: var(--space-xl);
      font-size: var(--text-sm);
    }

    .search-trigger--wide {
      justify-self: stretch;
      font-size: var(--text-sm);
    }
  }

  @media (min-width: 36rem) {
    .search-filters {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }
  }
</style>
