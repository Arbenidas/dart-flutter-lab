---
interface LessonItem {
  id: string;
  title: string;
  href: string;
  moduleId: string;
}

interface Props {
  lessons: LessonItem[];
}

const { lessons } = Astro.props;
---

<section class="review-board" data-review-board data-lessons={JSON.stringify(lessons)}>
  <div class="review-board__intro">
    <p class="eyebrow">Recuperación activa</p>
    <h2>Explica antes de mirar</h2>
    <p>
      Abre una pregunta, responde de memoria y registra si necesitaste ayuda. Fallar no borra nada:
      mueve el mismo repaso a mañana.
    </p>
  </div>
  <div class="review-list" data-review-list>
    <article class="review-empty panel">
      <h3>No hay repasos vencidos</h3>
      <p>Completa una lección para programar la primera recuperación al día siguiente.</p>
      <a class="button" href="/ruta/">Abrir la ruta</a>
    </article>
  </div>
  <p class="storage-warning" data-storage-warning hidden>
    El estado funciona en memoria. Exporta antes de cerrar esta pestaña.
  </p>
</section>

<script>
  import { SITE } from '../config';
  import { createProgressRepository, isReviewDue } from '../lib/progress';

  document.querySelectorAll<HTMLElement>('[data-review-board]').forEach(async (root) => {
    const lessons = JSON.parse(root.dataset.lessons ?? '[]') as Array<{
      id: string;
      title: string;
      href: string;
    }>;
    const byId = new Map(lessons.map((lesson) => [lesson.id, lesson]));
    const repository = await createProgressRepository(SITE.contentVersion);
    const warning = root.querySelector<HTMLElement>('[data-storage-warning]');
    if (warning) warning.hidden = repository.mode !== 'memory';
    const list = root.querySelector<HTMLElement>('[data-review-list]');

    const render = async () => {
      if (!list) return;
      const snapshot = await repository.getSnapshot();
      const due = snapshot.lessons
        .filter((item) => isReviewDue(item))
        .sort((a, b) => (a.review?.dueAtUtc ?? '').localeCompare(b.review?.dueAtUtc ?? ''));
      if (!due.length) {
        list.innerHTML =
          '<article class="review-empty panel"><h3>No hay repasos vencidos</h3><p>Completa una lección para programar la primera recuperación al día siguiente.</p><a class="button" href="/ruta/">Abrir la ruta</a></article>';
        return;
      }
      list.replaceChildren(
        ...due.map((progress) => {
          const lesson = byId.get(progress.lessonId);
          const article = document.createElement('article');
          article.className = 'review-card panel';
          const stage = (progress.review?.stage ?? 0) + 1;
          const title = document.createElement('h3');
          title.textContent = lesson?.title ?? progress.lessonId;
          const meta = document.createElement('p');
          meta.className = 'review-card__meta';
          meta.textContent = `Repaso ${stage} de 4 · responde sin abrir la lección`;
          const prompt = document.createElement('p');
          prompt.textContent =
            'Explica el concepto central, un error común y un caso donde lo reaplicarías.';
          const actions = document.createElement('div');
          actions.className = 'review-card__actions';
          const retry = document.createElement('button');
          retry.className = 'button';
          retry.textContent = 'Necesito practicar';
          const pass = document.createElement('button');
          pass.className = 'button button--primary';
          pass.textContent = 'Lo expliqué sin ayuda';
          const open = document.createElement('a');
          open.className = 'review-card__link';
          open.href = lesson?.href ?? '/ruta/';
          open.textContent = 'Abrir lección después';
          retry.addEventListener('click', async () => {
            await repository.recordReview(progress.lessonId, false);
            await render();
          });
          pass.addEventListener('click', async () => {
            await repository.recordReview(progress.lessonId, true);
            await render();
          });
          actions.append(retry, pass, open);
          article.append(meta, title, prompt, actions);
          return article;
        }),
      );
    };
    await render();
    repository.subscribe(() => void render());
  });
</script>

<style>
  .review-board,
  .review-list {
    display: grid;
    gap: var(--space-xl);
  }

  .review-board__intro {
    display: grid;
    gap: var(--space-sm);
    max-width: var(--content-measure);
  }

  .review-card,
  .review-empty {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  .review-card__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .review-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .review-card__link {
    font-weight: 700;
    white-space: nowrap;
  }

  .storage-warning {
    padding: var(--space-sm);
    border: var(--rule-strong) dashed var(--color-warning);
  }

  @media (min-width: 60rem) {
    .review-card {
      grid-template-columns: 8rem minmax(0, 1fr);
    }

    .review-card > :not(.review-card__meta) {
      grid-column: 2;
    }

    .review-card__meta {
      grid-column: 1;
      grid-row: 1 / 5;
    }
  }
</style>
