---
import BaseLayout from '../layouts/BaseLayout.astro';

const movements = [
  {
    name: 'Intento',
    question: '¿Qué escribes sin mirar nada?',
    artifact: 'Tu código o tu predicción, aunque falle.',
    action:
      'Empieza en una página en blanco. El intento fallido abre el hueco donde después entra la información; leer primero se siente mejor y enseña menos.',
    evidence: 'Lo verificas tú',
  },
  {
    name: 'Evidencia',
    question: '¿Qué respondió la máquina?',
    artifact: 'La salida, el error o el resultado del test, exactos.',
    action:
      'Ejecuta y copia lo que dijo la herramienta, no tu resumen de lo que dijo. Es la única prueba de esta lista que no depende de tu opinión.',
    evidence: 'Lo verifica la máquina',
  },
  {
    name: 'Fuente',
    question: '¿Qué dice la documentación oficial?',
    artifact: 'Un encabezado citado y su regla parafraseada.',
    action:
      'Llega con una pregunta concreta, localiza el encabezado que la responde y ciérralo antes de explicarla. «Lee toda la página» no es una instrucción.',
    evidence: 'Lo verifica el enlace',
  },
  {
    name: 'Criterio',
    question: '¿Qué decides y qué costo aceptas?',
    artifact: 'Dos opciones comparadas y una descartada con motivo.',
    action:
      'Una decisión sin alternativa descartada todavía no es criterio. La arquitectura empieza cuando puedes defender un límite.',
    evidence: 'Lo verifica el repaso',
  },
] as const;

const ladder = [
  { day: 'Día 1', verb: 'Recordar', action: 'Responde la pregunta central sin abrir nada.' },
  {
    day: 'Día 3',
    verb: 'Reescribir',
    action: 'Vuelve a escribir el ejercicio en un archivo vacío.',
  },
  { day: 'Día 7', verb: 'Explicar', action: 'Cuéntaselo en voz alta a alguien, sin apuntes.' },
  {
    day: 'Día 21',
    verb: 'Transferir',
    action: 'Aplica la idea a un problema que no habías visto.',
  },
] as const;
---

<BaseLayout
  title="Ciclo de evidencia"
  description="El ciclo de evidencia: intento, evidencia, fuente y criterio, más una escalera de repaso a 1, 3, 7 y 21 días."
>
  <div data-pagefind-body>
    <header class="page-head container">
      <p class="eyebrow">Ciclo de evidencia</p>
      <h1>La respuesta llega después del razonamiento.</h1>
      <p>
        Cuatro movimientos ordenados de la prueba más débil a la más fuerte: intento, evidencia,
        fuente y criterio. Cada uno produce un artefacto de tipo distinto, así que ninguno se puede
        rellenar con el anterior.
      </p>
    </header>

    <section class="method-sequence container" aria-labelledby="sequence-title">
      <header>
        <p class="eyebrow">Un ciclo, no una lista de casillas</p>
        <h2 id="sequence-title">Cada movimiento deja una prueba diferente</h2>
      </header>
      <ol>
        {
          movements.map((movement, index) => (
            <li>
              <div class="method-letter" aria-hidden="true">
                {index + 1}
              </div>
              <div class="method-copy">
                <span>{movement.evidence}</span>
                <h3>{movement.name}</h3>
                <p class="method-question">{movement.question}</p>
                <p>
                  {movement.action} <strong>Artefacto:</strong> {movement.artifact}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="method-sequence container" aria-labelledby="ladder-title">
      <header>
        <p class="eyebrow">El movimiento que ocurre después</p>
        <h2 id="ladder-title">La reaplicación no cabe en la misma sesión</h2>
        <p>
          Reaplicar algo el mismo día que lo aprendiste sigue siendo reconocimiento. Por eso el
          ciclo se cierra días más tarde, y cada etapa pide algo más exigente que la anterior.
        </p>
      </header>
      <ol>
        {
          ladder.map((stage, index) => (
            <li>
              <div class="method-letter" aria-hidden="true">
                {stage.day.replace('Día ', '')}
              </div>
              <div class="method-copy">
                <span>Repaso {index + 1} de 4</span>
                <h3>{stage.verb}</h3>
                <p class="method-question">{stage.day}</p>
                <p>{stage.action}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="method-notes container">
      <section class="hint-ladder" aria-labelledby="hints-title">
        <p class="eyebrow">Pistas socráticas</p>
        <h2 id="hints-title">Ayuda que no reemplaza el intento</h2>
        <ol>
          <li>
            <strong>Primera pista:</strong> vuelve tu atención hacia una condición o palabra clave.
          </li>
          <li>
            <strong>Segunda pista:</strong> reduce el espacio de posibilidades sin escribir la solución.
          </li>
          <li>
            <strong>Tercera pista:</strong> propone un siguiente experimento, no una respuesta para copiar.
          </li>
        </ol>
        <p>
          Trabaja hasta 20 minutos con una hipótesis clara. Si sigues detenido, abre una pista y
          registra qué dato te faltaba. Después de las pistas viene la documentación oficial, nunca
          un modelo de lenguaje.
        </p>
      </section>

      <aside class="ai-rule" aria-labelledby="ai-rule-title">
        <p class="eyebrow">IA con fricción útil</p>
        <h2 id="ai-rule-title">Pregunta después de producir evidencia</h2>
        <p>
          Comparte tu predicción, el ejemplo mínimo, la salida exacta y la fuente que ya
          consultaste. Pide una pregunta de diagnóstico o un contraejemplo antes que código
          terminado.
        </p>
      </aside>
    </div>

    <section class="session container" aria-labelledby="session-title">
      <div>
        <p class="eyebrow">Sesión de 60 minutos</p>
        <h2 id="session-title">Menos contenido, más recuperación</h2>
      </div>
      <dl>
        <div><dt>20 min</dt><dd>Atiende la escalera de repaso vencida, de memoria.</dd></div>
        <div>
          <dt>30 min</dt><dd>Trabaja una lección nueva con el ciclo de evidencia completo.</dd>
        </div>
        <div>
          <dt>10 min</dt><dd>Escribe una nota propia y prepara el siguiente punto de entrada.</dd>
        </div>
      </dl>
      <a class="button button--primary" href="/inicio/">Preparar el laboratorio</a>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head,
  .method-sequence,
  .hint-ladder,
  .ai-rule,
  .session {
    display: grid;
    gap: var(--space-lg);
  }

  .page-head {
    padding-block: var(--space-2xl);
  }

  .page-head h1 {
    max-width: 14ch;
  }

  .page-head p:last-child {
    max-width: 62ch;
    font-size: var(--text-md);
  }

  .method-sequence {
    padding-block: var(--space-xl) var(--space-2xl);
    border-block-start: var(--rule-strong) solid var(--color-ink);
  }

  .method-sequence > header {
    display: grid;
    gap: var(--space-xs);
  }

  .method-sequence ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .method-sequence li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-lg);
    border-block-end: var(--rule-thin) solid var(--color-rule);
  }

  .method-letter {
    display: grid;
    width: 3.25rem;
    aspect-ratio: 1;
    place-items: center;
    border: var(--rule-strong) solid var(--color-ink);
    background: var(--color-acid);
    color: var(--color-acid-ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    box-shadow: var(--shadow-pressed);
  }

  .method-copy {
    display: grid;
    gap: var(--space-xs);
  }

  .method-copy > span {
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .method-question {
    font-weight: 700;
  }

  .method-copy p:last-child {
    max-width: 62ch;
    color: var(--color-ink-muted);
  }

  .method-notes {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
  }

  .hint-ladder ol {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding-inline-start: var(--space-lg);
  }

  .hint-ladder > p:last-child {
    max-width: 62ch;
    padding-inline-start: var(--space-md);
    border-inline-start: var(--rule-strong) solid var(--color-ink);
  }

  .ai-rule {
    align-content: start;
    padding: var(--space-lg);
    border: var(--rule-strong) solid var(--color-ink);
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-hard);
  }

  .session {
    margin-block-end: var(--space-3xl);
    padding-block: var(--space-xl);
    border-block: var(--rule-strong) solid var(--color-ink);
  }

  .session > div {
    display: grid;
    gap: var(--space-xs);
  }

  .session dl {
    display: grid;
    margin: 0;
    border-block-start: var(--rule-thin) solid var(--color-rule);
  }

  .session dl div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-block-end: var(--rule-thin) solid var(--color-rule);
  }

  .session dt {
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .session dd {
    margin: 0;
    color: var(--color-ink-muted);
  }

  .session .button {
    justify-self: start;
  }

  @media (min-width: 52rem) {
    .method-sequence li {
      grid-template-columns: 4rem 8rem minmax(0, 1fr);
      align-items: start;
    }

    .method-copy {
      display: grid;
      grid-column: 2 / -1;
      grid-template-columns: 8rem minmax(0, 1fr);
    }

    .method-copy > span {
      grid-column: 1;
    }

    .method-copy h3 {
      grid-column: 1;
    }

    .method-copy p {
      grid-column: 2;
    }

    .method-question {
      grid-row: 1 / 3;
    }

    .method-notes {
      grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
      align-items: start;
    }

    .ai-rule {
      transform: rotate(0.3deg);
    }
  }
</style>
